{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Overrides": {
        "Microsoft": "Information",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "Using": [ "Serilog.Sinks.File", "Serilog.Sinks.TelegramBot" ],
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "bin/logs/log.txt",
          "rollingInterval": "Day"
        }
      },
      {
        "Name": "TelegramBot",
        "Args": {
          "Token": "",
          "ChatId": "",
          "ReadableApplicationName": "Kabutar",
          "UseEmoji": true,
          "RestrictedToMinimumLevel": "Information",
          "BatchPostingLimit": 5,
          "Period": "0.00:00:20",
          "Mode": "Logs"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  "AllowedHosts": "*",
  "Jwt": {
    "Key": "",
    "Issuer": "",
    "Audience": "",
    "Lifetime": 300
  },
  "Email": {
    "Host": "smtp.gmail.com",
    "EmailAddress": "",
    "Password": ""
  }
}
